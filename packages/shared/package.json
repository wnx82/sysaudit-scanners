{
  "name": "@sysaudit/shared",
  "version": "0.69.0",
  "private": true,
  "description": "Utilitaires partagés SysAudit (valeurs inconnues, anonymisation, SemVer, tailles, identifiants)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
