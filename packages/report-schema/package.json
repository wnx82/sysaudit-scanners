{
  "name": "@sysaudit/report-schema",
  "version": "0.72.0",
  "private": true,
  "description": "Schéma JSON SysAudit — source de vérité du format de rapport, versionné indépendamment",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript-native/bin/tsc --build && node scripts/emit-json-schema.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@sysaudit/shared": "*",
    "zod": "^4.5.4"
  }
}
